# ClaudeBridge — copy to .env and fill in.
# install.sh enforces mode 0600 on .env.
#
# 1) TELEGRAM_BOT_TOKEN — from @BotFather. Use a DEDICATED bot for ClaudeBridge,
#    not one you also use for trading alerts, notifications, etc.
TELEGRAM_BOT_TOKEN=PUT_BOT_TOKEN_HERE

# 2) TELEGRAM_ALLOWED_USER_IDS — comma-separated numeric Telegram user IDs allowed
#    to talk to this bot. Get yours from @userinfobot.
#    Anyone not in this list is silently dropped.
TELEGRAM_ALLOWED_USER_IDS=PUT_YOUR_USER_ID_HERE

# 3) CLAUDE_CODE_OAUTH_TOKEN — required if you authenticate to Claude Code via
#    OAuth (Pro/Max plan with `claude /login`). Interactive shells inherit
#    this, but systemd --user services don't. Without it the daemon's
#    `claude -p` subprocesses get HTTP 401 from Anthropic's API.
#    Skip this if you authenticate with ANTHROPIC_API_KEY instead.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# 4) Optional overrides
# CLAUDE_BIN=/path/to/claude
# CLAUDE_BRIDGE_PROJECT_ROOT=/path/to/your/Project    # default: $HOME/Project
# BRIDGE_LOG_LEVEL=INFO
# BRIDGE_TIMEOUT_SECS=600
